VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=YOUR_META_PIXEL_ID
VITE_WHATSAPP_NUMBER=91XXXXXXXXXX
# Optional: extra Content-Security-Policy connect-src origins (e.g. for local test doubles). Leave blank for production.
VITE_CSP_EXTRA_CONNECT_SRC=
# Enable only after configuring Cloudflare Turnstile's secret in Supabase Auth.
VITE_TURNSTILE_SITE_KEY=
# Opt-in customer sandbox checkout. Live payments remain disabled on the backend.
VITE_ENABLE_RAZORPAY_TEST_CHECKOUT=false
# Backend only: copy into a separate ignored .env.razorpay.local for Supabase secrets.
# Never use a VITE_ prefix for RAZORPAY_KEY_SECRET.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET
