{
  "name": "luvia-catalogue",
  "private": true,
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node --experimental-strip-types scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test e2e/release.spec.ts e2e/artisans.spec.ts e2e/customer-love.spec.ts e2e/admin-product-patterns.spec.ts",
    "test:e2e:full": "playwright test",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:all": "npm run lint && npm run test && npm run test:e2e && npm run build",
    "backup:images": "node --env-file=.env.r2.local scripts/backup-r2-images.mjs"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "buffer": "^6.0.3",
    "docx": "^9.15.4",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdfmake": "^0.3.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "aws4fetch": "^1.0.20",
    "jsdom": "^29.1.1",
    "mmdb-lib": "^3.0.3",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
